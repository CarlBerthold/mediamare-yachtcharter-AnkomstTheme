{%- if cart != empty -%}
  {%- for item in cart.items -%}
    <div id="cart-notification-product-{{ item.key }}" class="cart-item">
      {%- if item.image -%}
        {% comment %} <div class="cart-notification-product__image global-media-settings">
          <img
            src="{{ item.image | image_url: width: 750 }}"
            alt="{{ item.image.alt | escape }}"
            width="300"
            height="{{ 300 | divided_by: item.image.aspect_ratio | ceil }}"
            loading="lazy"
          >
        </div> {% endcomment %}
      {%- endif -%}
      <div class="cart-notification-product__info">
        {%- if settings.show_vendor -%}
          <p class="caption-with-letter-spacing light">{{ item.product.vendor }}</p>
        {%- endif -%}
        <h3 class="cart-notification-product__name">{{ item.product.title | escape }}</h3>
        <dl>
          {%- unless item.product.has_only_default_variant -%}
            {%- for option in item.options_with_values -%}
              <div class="product-option">
                <dt>{{ option.name }}:</dt>
                <dd>{{ option.value }}</dd>
              </div>
            {%- endfor -%}
          {%- endunless -%}
           {%- for property in item.properties -%}
                            {%- assign property_first_char = property.first | slice: 0 -%}
                            {%- if property.last != blank and property_first_char != '_' -%}
                              {%- assign property_key = property.first | downcase -%}
                              {%- if property_key == 'date' -%}
                                <!-- Special date styling -->
                                <div class="cart-option-item cart-option-date">
                                  <span class="cart-option-label">Datum:</span>
                                  <div class="cart-option-value">
                                    <div class="cart-item__date-range">
                                      {%- assign date_parts = property.last | split: ' bis ' -%}
                                      {%- if date_parts.size == 1 -%}
                                        {%- assign date_parts = property.last | split: 'bis' -%}
                                      {%- endif -%}
                                      {%- if date_parts.size == 2 -%}
                                        <div class="date-start">
                                          <strong>Abfahrt:</strong>
                                          <span class="date-value">{{ date_parts[0] | strip }}</span>
                                        </div>
                                        <div class="date-end">
                                          <strong>Rückkehr:</strong>
                                          <span class="date-value">{{ date_parts[1] | strip }}</span>
                                        </div>
                                      {%- else -%}
                                        {{ property.last }}
                                      {%- endif -%}
                                    </div>
                                  </div>
                                </div>
                              {%- elsif property_key != 'später bezahlen' -%}
                                <div class="cart-option-item">
                                  <span class="cart-option-label">{{ property.first }}:</span>
                                  <span class="cart-option-value">
                                    {%- if property.last contains '/uploads/' -%}
                                      <a href="{{ property.last }}" class="link" target="_blank">
                                        {{ property.last | split: '/' | last }}
                                      </a>
                                    {%- else -%}
                                      {{ property.last }}
                                    {%- endif -%}
                                  </span>
                                </div>
                              {%- endif -%}
                            {%- endif -%}
                          {%- endfor -%}

        <div class="cart-option-item cart-option-total">
                            <span class="cart-option-value">
                              {%- if item.original_line_price != item.final_line_price -%}
                                {% comment %} <div class="cart-option-item cart-option-price">
                                  <span class="cart-option-label">30% der Mietdauer zzgl. extra produkten:</span>
                                  <span class="cart-option-value">
                                    <s class="cart-item__old-price">{{ item.original_price | money }}</s>
                                    <strong class="cart-item__final-price">{{ item.final_price | money }}</strong>
                                  </span>
                                </div> {% endcomment %}
                                 {%- for property in item.properties -%}
                                {%- if property.first == 'später bezahlen' -%}
                                  {%- assign later_payment_string = property.last | replace: '€', '' | replace: '.', '' | replace: ',', '.' -%}
                                  {%- assign later_payment_number = later_payment_string | times: 1 -%}
                                  {%- assign later_payment = later_payment_number | times: 100 -%}
                                  {%- assign base_rental_price = later_payment | divided_by: 70 | times: 100 | round -%}
                                  {%- break -%}
                                {%- endif -%}
                              {%- endfor -%}

                              {%- if base_rental_price -%}
                                 {%- if base_rental_price == item.final_line_price %}
                                  <span>{{ base_rental_price | money }}</span>
                                  <span>{{ item.final_price | money }}</span>
                                  <span>{{ item.original_price | money }}</span>

                                  
                                 {% endif %}
                                <!-- Show breakdown if we have base rental price -->
                                {%- assign deposit_amount = base_rental_price | times: 30 | divided_by: 100 -%}
                                {%- assign addon_total = item.original_price | minus: deposit_amount | minus: discount -%}
                                {% assign discount = item.original_price | minus: item.final_price %}
                                {%- if addon_total > 0 -%}
                                  <div class="cart-option-item cart-option-addons-total">
                                    <span class="cart-option-label">Zusatzprodukte (gesamt):</span>
                                    <span class="cart-option-value">{{ addon_total | money }}</span>
                                  </div>
                                {%- endif -%}
                                
                                <div class="cart-option-item cart-option-base-price">
                                  <span class="cart-option-label">Mietpreis (ohne Zusatzprodukte):</span>
                                  <span class="cart-option-value">{{ base_rental_price | money }}</span>
                                </div>
                                
                              {%- else -%}
                                <!-- Fallback if we can't calculate base rental price -->
                                <div class="cart-option-item cart-option-price">
                                  <span class="cart-option-label">Anzahlung (30%):
                                    <span class="cart-option-price__disclaimer">inkl. der ausgewählten Zusatzprodukte</span>
                                  </span>
                                  <span class="cart-option-value">{{ item.original_price | money }}</span>
                                </div>
                              {%- endif -%}
                              

                              {%- else -%}
                                <!-- Price option -->
                              {%- if item.original_price != item.final_price -%}
                                <div class="cart-option-item cart-option-price">
                                  <span class="cart-option-label">30% der Mietdauer zzgl. extra produkten:</span>
                                  <span class="cart-option-value">
                                    <s class="cart-item__old-price">{{ item.original_price | money }}</s>
                                    <strong class="cart-item__final-price">{{ item.final_price | money }}</strong>
                                  </span>
                                </div>
                              {%- else -%}
                              
                              {%- assign base_rental_price = null -%}
                              {%- assign later_payment = null -%}
                              
                              <!-- Check if we can calculate base rental price from "später bezahlen" (70% remaining) -->
                              {%- for property in item.properties -%}
                                {%- if property.first == 'später bezahlen' -%}
                                  {%- assign later_payment_string = property.last | replace: '€', '' | replace: '.', '' | replace: ',', '.' -%}
                                  {%- assign later_payment_number = later_payment_string | times: 1 -%}
                                  {%- assign later_payment = later_payment_number | times: 100 -%}
                                  {%- assign base_rental_price = later_payment | divided_by: 70 | times: 100 | round -%}
                                  {%- break -%}
                                {%- endif -%}
                              {%- endfor -%}

                              {%- if base_rental_price -%}
                                <!-- Show breakdown if we have base rental price -->
                                {%- assign deposit_amount = base_rental_price | times: 30 | divided_by: 100 -%}
                                {%- assign addon_total = item.original_price | minus: deposit_amount -%}
                                {%- if addon_total > 0 -%}
                                  <div class="cart-option-item cart-option-addons-total">
                                    <span class="cart-option-label">Zusatzprodukte (gesamt):</span>
                                    <span class="cart-option-value">{{ addon_total | money }}</span>
                                  </div>
                                {%- endif -%}
                                
                                <div class="cart-option-item cart-option-base-price">
                                  <span class="cart-option-label">Mietpreis (ohne Zusatzprodukte):</span>
                                  <span class="cart-option-value">{{ base_rental_price | money }}</span>
                                </div>
                                
                              {%- else -%}
                                <!-- Fallback if we can't calculate base rental price -->
                                <div class="cart-option-item cart-option-price">
                                  <span class="cart-option-label">Anzahlung (30%):
                                    <span class="cart-option-price__disclaimer">inkl. der ausgewählten Zusatzprodukte</span>
                                  </span>
                                  <span class="cart-option-value">{{ item.original_price | money }}</span>
                                </div>
                              {%- endif -%}
                              {%- endif -%}
                                
                              {%- endif -%}
                            </span>
                          </div>
        </dl>
        {%- if item.selling_plan_allocation != null -%}
          <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
{%- endif -%}
