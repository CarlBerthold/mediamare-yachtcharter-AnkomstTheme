<div>
<div class="columns">
   <h1>Rechnung</h1>
   <div>
      <p style="text-align: right; margin: 0;">
         <strong>Rechnungsnummer: {{ order.order_name }}</strong><br />
         {% if order.po_number %}Bestellnummer: {{ order.po_number }}<br />{% endif %}
         Rechnungsdatum: {{ order.created_at | date: "%d.%m.%Y" }}<br />
         Leistungsdatum: {{ order.created_at | date: "%d.%m.%Y" }}
      </p>
   </div>
</div>
<div class="columns" style="margin-top: 1.5em;">
   <div class="address">
      <strong>Absender</strong><br/>
      {{ shop.name }}<br/>
      {{ shop.address | format_address }}
      {% if shop.phone %}Tel.: {{ shop.phone }}{% endif %}<br/>
      {% if shop.email %}E-Mail: {{ shop.email }}{% endif %}<br/>
      <!-- Bitte ergänzen Sie hier Ihre Steuernummer/USt-IdNr. -->
      <!-- Steuernummer: [Ihre Steuernummer] -->
      <!-- USt-IdNr.: [Ihre USt-IdNr.] -->
   </div>
   {% if order.billing_address %}
   <div class="address">
      <strong>Rechnungsadresse</strong>
      {{ order.billing_address | format_address  }}
   </div>
   {% endif %}
   {% if order.shipping_address %}
   <div class="address">
      <strong>Lieferadresse</strong>
      {{ order.shipping_address | format_address  }}
      {% if order.shipping_address.phone %}Tel.: {{ order.shipping_address.phone }}{% endif %}
   </div>
   {% endif %}
</div>
<hr />
<h2>Bestellübersicht</h2>
<table class="table-tabular" style="margin: 1em 0 0 0;">
   <thead>
      <tr>
         <th>Menge</th>
         <th>Artikel</th>
         <th style="text-align: right;">Preis</th>
      </tr>
   </thead>
   <tbody>
      {% for line_item in order.line_items %}
      <tr>
         <td>{{ line_item.quantity }}</td>
         <td>{{ line_item.title }}
            {% if line_item.line_level_discount_allocations.size > 0 %}
            <span class="subduedText">
            {% for discount_allocation in line_item.line_level_discount_allocations %}
            <br>{{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})
            {% endfor %}
            </span>
            {% endif %}
            
            <!-- Buchungsdaten anzeigen -->
            {% if line_item.properties.size > 0 %}
            <br><small style="color: #666;">
            {% for property in line_item.properties %}
              {% assign first_char = property[0] | slice: 0, 1 %}
              {% if first_char != '_' %}
                <br>{{ property[0] }}: {{ property[1] }}
              {% endif %}
            {% endfor %}
            </small>
            {% endif %}
         </td>
         <td style="text-align: right;">
            {% if line_item.original_price != line_item.final_price %}
            <span class="subduedText"><s>{{ line_item.original_price | money }}</s></span>
            {% endif %}
            {{ line_item.final_price | money }}
         </td>
      </tr>
      {% endfor %}
      <tr>
         <td colspan="2" style="text-align: right;">Zwischensumme (netto)</td>
         <td style="text-align: right;">{{ order.line_items_subtotal_price | money }}</td>
      </tr>
      {% assign has_shipping_discount = false %}
      {% for discount_application in order.discount_applications %}
      {% if discount_application.target_type == 'shipping_line' %}
      {% assign has_shipping_discount = true %}
      {% endif %}
      {% if discount_application.target_selection == 'all' and discount_application.target_type != 'shipping_line' %}
      <tr>
         <td colspan="2" style="text-align: right;">{% if discount_application.title %}<span class="subduedText">{{ discount_application.title }}</span>{% endif %}</td>
         <td style="text-align: right;">-{{ discount_application.total_allocated_amount | money }}</td>
      </tr>
      {% endif %}
      {% endfor %}
      <tr>
         <td colspan="2" style="text-align: right;">MwSt. (19%)</td>
         <td style="text-align: right;">{{ order.tax_price | money }}</td>
      </tr>
      {% if order.shipping_address %}
      <tr>
         <td colspan="2" style="text-align: right;">Versandkosten</td>
         <td style="text-align: right;">{% if has_shipping_discount %}KOSTENLOS{% else %}{{ order.shipping_price | money }}{% endif %}</td>
      </tr>
      {% endif %}
      <tr>
         <td colspan="2" style="text-align: right;"><strong>Gesamtsumme (brutto)</strong></td>
         <td style="text-align: right;"><strong>{{ order.total_price | money }}</strong></td>
      </tr>
      {% if order.net_payment != order.total_net_amount %}
      <tr>
         <td colspan="2" style="text-align: right;">Bereits bezahlt</td>
         <td style="text-align: right;">{{ order.net_payment | money }}</td>
      </tr>
      {% endif %}
      {% if order.total_refunded_amount > 0 %}
      <tr>
         <td colspan="2" style="text-align: right;">Erstatteter Betrag</td>
         <td style="text-align: right;">-{{ order.total_refunded_amount | money }}</td>
      </tr>
      {% endif %}
      {% if order.net_payment != order.total_net_amount %}
      <tr>
      {% if order.financial_status != 'paid' %}
         <td colspan="2" style="text-align: right;"><strong>Offener Betrag</strong></td>
         <td style="text-align: right;"><strong>{{ order.total_price | minus: order.net_payment | money }}</strong></td>
      {% endif %}
      </tr>
      {% endif %}
   </tbody>
</table>
{% comment %}
<!-- Transaction details section - German version -->
{% if order.financial_status != 'paid' %}
<h2>Zahlungsdetails</h2>
<table class="table-tabular" style="margin: 0 0 1.5em 0;">
   <thead>
      <tr>
         <th>Zahlungsart</th>
         <th>Betrag</th>
         <th>Art</th>
         <th>Status</th>
      </tr>
   </thead>
   <tbody>
      {% for transaction in order.transactions %}
      <tr>
         <td>{{ transaction.gateway }}</td>
         <td>{{ transaction.amount | money }}</td>
         <td>{{ transaction.kind }}</td>
         <td>{{ transaction.status }}</td>
      </tr>
      {% endfor %}
   </tbody>
</table>
{% endif %}
{% endcomment %}
{% if order.note %}
<h2>Notiz</h2>
<p>{{ order.note }}</p>
{% endif %}
<!-- German Business Footer Information -->
<hr style="margin-top: 2em;" />
<div style="font-size: 0.9em; margin-top: 1em;">
   <h3>Zahlungsbedingungen</h3>
   <p>Zahlung binnen 14 Tagen nach Rechnungsdatum ohne Abzug.</p>
   
   <!-- Ergänzen Sie hier Ihre Bankverbindung falls gewünscht -->
   <!--
   <h3>Bankverbindung</h3>
   <p>
      Kontoinhaber: {{ shop.name }}<br/>
      IBAN: [Ihre IBAN]<br/>
      BIC: [Ihre BIC]<br/>
      Bank: [Ihre Bank]
   </p>
   -->
   
   <p style="margin-top: 1.5em;">
      <strong>Kontakt:</strong><br/>
      Bei Fragen zu dieser Rechnung wenden Sie sich bitte an:<br/>
      E-Mail: <u>{{ shop.email }}</u>{% if shop.phone %}<br/>
      Telefon: {{ shop.phone }}{% endif %}
   </p>
   
   <p style="font-size: 0.8em; margin-top: 2em; color: #666;">
      <strong>Hinweis:</strong> Diese Rechnung wurde elektronisch erstellt und ist ohne Unterschrift gültig.<br/>
      Bitte bewahren Sie diese Rechnung für Ihre Unterlagen auf.
   </p>
</div>
</div>