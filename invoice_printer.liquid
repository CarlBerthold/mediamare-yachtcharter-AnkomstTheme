<div class="invoice">



  <!-- HEADER -->
  <div class="columns">
    <div>
      <img src="https://cdn.shopify.com/s/files/1/0767/5215/9056/files/241223_Logo_A.svg?v=1735219334" alt="{{ shop.name }}" width="180" height="100" style="max-width: 200px; margin-bottom: 20px; text-align:left;"><br>
      <strong>{{ shop.name }}</strong><br>
      {{ shop.address | format_address }}<br>
      {{ shop.email }}<br>
      {{ shop.phone }}<br>
      MwSt.-ID: {{ shop.tax_id | default: "DE 199465922" }} <!-- TODO falls anders -->
    </div>

    <div style="display: flex;
    text-align: right;
    flex-direction: column;
    justify-content: flex-end; text-align:right;">
      <h2>RECHNUNG</h2>
      <span><strong>Rechnungsnummer:</strong> {{ order.order_name }}</span>
      <span><strong>Ausstellungsdatum:</strong> {{ order.created_at | date: "%d.%m.%Y" }}</span>
      <span><strong>Lieferdatum:</strong> {{ order.created_at | date: "%d.%m.%Y" }}</span> <!-- TODO Lieferdatum -->
    </div>
  </div>

  <hr>

 <div class="columns" style="margin-top: 1.2em; display:flex; gap: 24px; align-items:flex-start;">

 <!-- HÄNDLER -->
  {% comment %} <div class="address" style="flex:1;">
    <strong>Händler</strong><br>
    {{ shop.name }}<br>
    {{ shop.address | format_address }}<br><br>
    {{ shop.email }}<br>
    {{ shop.phone }}<br>
    MwSt.-ID: {{ shop.tax_id | default: "DE 199465922" }}
  </div> {% endcomment %}

  <!-- ZUSTELLMETHODE -->
  <div class="address" style="flex:1;">
    <strong>Zustellmethode</strong><br>
    Digitaler Download <!-- TODO falls Mapping -->
  </div>

   <!-- RECHNUNG AN -->
  <div class="address" style="flex:1; text-align: right;">
    <strong>Rechnung an</strong><br>
    {{ order.billing_address.name }}<br>
    {{ order.billing_address.company }}<br>
    {{ order.billing_address.address1 }}<br>
    {{ order.billing_address.zip }} {{ order.billing_address.city }}<br>
    {{ order.billing_address.country }}
  </div>

  

</div>

  <hr>

  <!-- CALCULATE TOTAL DISCOUNTS -->
  {% comment %} Calculate total of all line-level discounts {% endcomment %}
  {% assign total_line_discounts = 0 %}
  {% for line in order.line_items %}
    {% assign total_line_discounts = total_line_discounts | plus: line.line_level_total_discount %}
  {% endfor %}

  <!-- ITEMS TABLE -->
  <table class="table-tabular" style="margin-top:1em;">
    <thead>
      <tr>
        <th>Beschreibung</th>
        <th>Anzahl</th>
        <th>Grundpreis</th>
        <th>MwSt.-Satz</th>
        <th style="text-align:right;">Betrag</th>
      </tr>
    </thead>

    <tbody>
      {% for line_item in order.line_items %}
      {% comment %} Check if this line has date properties {% endcomment %}
      {% assign has_date_property = false %}
      {% for property in line_item.properties %}
        {% assign prop_name = property[0] | downcase %}
        {% if prop_name contains 'date' or prop_name contains 'datum' %}
          {% assign has_date_property = true %}
          {% break %}
        {% endif %}
      {% endfor %}

      <tr>
        <td>
          {{ line_item.title }}

          {% if line_item.properties.size > 0 %}
          <br><small>
            {% for prop in line_item.properties %}
              {% assign first_char = prop[0] | slice: 0, 1 %}
              {% if first_char != '_' %}
                {{ prop[0] }}: {{ prop[1] }}<br>
              {% endif %}
            {% endfor %}
          </small>
          {% endif %}
        </td>

        <td>{{ line_item.quantity }}</td>

        <td>{{ line_item.original_price | money }}</td>

        <td>19 %</td> <!-- TODO dynamisch -->

        <td style="text-align:right;">
          {% if has_date_property %}
            {% comment %} This is a yacht charter item - show adjusted price {% endcomment %}
            {% comment %} {% assign adjusted_price = line_item.original_line_price | minus: total_line_discounts %}
            {{ adjusted_price | money }} {% endcomment %}
            {{ line_item.original_line_price | money }}
          {% else %}
            {% comment %} This is an add-on item - show original price {% endcomment %}
            {{ line_item.original_line_price | money }}
          {% endif %}
        </td>
      </tr>

      {% comment %} {% if line_item.line_level_discount_allocations.size > 0 and has_date_property == true %}
        {% for discount in line_item.line_level_discount_allocations %}
        <tr>
          <td colspan="4" style="color:#777;">
            Rabatt: {{ discount.discount_application.title }}
          </td>
          <td style="text-align:right; color:#777;">
            -{{ total_line_discounts | money }}
          </td>
        </tr>
        {% endfor %}
      {% endif %} {% endcomment %}

      {% endfor %}

      

      <!-- SUBTOTAL -->
      <tr>
        <td colspan="4" style="text-align:right;">Zwischensumme</td>
        <td style="text-align:right;">
          {% assign adjusted_price = order.total_price | plus: total_line_discounts %}
          {{ adjusted_price | money }}
        </td>
      </tr>

      <!-- DISCOUNT SUMMARY -->
      {% if total_line_discounts > 0 %}
      <tr>
        <td colspan="4" style="text-align:right;">Rabatt</td>
        <td style="text-align:right; color:#777;">-{{ total_line_discounts | money }}</td>
      </tr>
      {% endif %}

      <!-- TAX -->
      <tr>
        <td colspan="4" style="text-align:right;">DE MwSt 19% (Inklusive)</td>
        <td style="text-align:right;">{{ order.tax_price | money }}</td>
      </tr>

      <!-- SHIPPING -->
      {% if order.shipping_price > 0 %}
      <tr>
        <td colspan="4" style="text-align:right;">Versand</td>
        <td style="text-align:right;">{{ order.shipping_price | money }}</td>
      </tr>
      {% endif %}

      <!-- TOTAL -->
      <tr>
        <td colspan="4" style="text-align:right;"><strong>Gesamt</strong></td>
        <td style="text-align:right;"><strong>{{ order.total_price | money }}</strong></td>
      </tr>
    </tbody>
  </table>

  <hr style="margin-top:1.5em;">

  <!-- FOOTER -->
  <div style="font-size:0.9em;">
    <strong>Gesamter Rechnungsbetrag:</strong> {{ order.total_price | money }}<br>

    <p style="margin-top:1em;">
      Zur Verfügung gestellt von: {{ shop.name }}<br>
      MwSt.-ID: {{ shop.tax_id | default: "DE 199465922" }}
    </p>

    <p>
      Ausgestellt am {{ order.created_at | date: "%d.%m.%Y" }}<br>
      Seite 1 von 1 für {{ order.order_name }}
    </p>
  </div>

</div>
